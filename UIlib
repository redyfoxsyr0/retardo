        if input.KeyCode == Enum.KeyCode.F5 and isOpen then
            self:ExecuteScript()
        end
        if input.KeyCode == Enum.KeyCode.F6 and isOpen then
            self:ClearEditor()
        end
        if input.KeyCode == Enum.KeyCode.F7 and isOpen then
