--[[
    UI Control Functions
]]

function VortexX:OpenUI()
    if not uiRefs.MainContainer then return end
    if isAnimating then return end
    
    isAnimating = true
    uiRefs.MainContainer.Visible = true
    uiRefs.Overlay.Visible = true
    
    -- Animate panel in
    local tweenService = game:GetService("TweenService")
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    local panelTween = tweenService:Create(uiRefs.Panel, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)})
    local overlayTween = tweenService:Create(uiRefs.Overlay, tweenInfo, {BackgroundTransparency = 0.6})
    
    panelTween:Play()
    overlayTween:Play()
    
    isOpen = true
    task.wait(0.35)
    isAnimating = false
end

function VortexX:CloseUI()
    if not uiRefs.MainContainer or not isOpen then return end
    if isAnimating then return end
    
    isAnimating = true
    
    local tweenService = game:GetService("TweenService")
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    
    local panelTween = tweenService:Create(uiRefs.Panel, tweenInfo, {Position = UDim2.new(0, -900, 0, 0)})
    local overlayTween = tweenService:Create(uiRefs.Overlay, tweenInfo, {BackgroundTransparency = 0})
    
    panelTween:Play()
    overlayTween:Play()
    
    isOpen = false
    task.wait(0.35)
    uiRefs.MainContainer.Visible = false
    uiRefs.Overlay.Visible = false
    isAnimating = false
end

function VortexX:ToggleUI()
    if isOpen then
        self:CloseUI()
    else
        self:OpenUI()
    end
end

function VortexX:IsOpen()
    return isOpen
end

--[[
    Script Management
]]

function VortexX:AddNewTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_" .. name
    tabBtn.Size = UDim2.new(0, 100, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.TextSize = 12
    tabBtn.Font = Enum.Font.SourceSans
    tabBtn.Parent = uiRefs.EditorTabsContainer
    
    -- Close tab button
    local closeTab = Instance.new("TextButton")
    closeTab.Size = UDim2.new(0, 16, 1, 0)
    closeTab.Position = UDim2.new(1, -18, 0, 0)
    closeTab.BackgroundTransparency = 1
    closeTab.Text = "×"
    closeTab.TextColor3 = Color3.fromRGB(200, 50, 50)
    closeTab.TextSize = 14
    closeTab.Font = Enum.Font.SourceSansBold
    closeTab.Parent = tabBtn
    
    closeTab.MouseButton1Click:Connect(function()
        if #scriptTabs > 1 then
            tabBtn:Destroy()
            for i, tab in ipairs(scriptTabs) do
                if tab == tabBtn then
                    table.remove(scriptTabs, i)
                    break
                end
            end
            self:UpdateEditorTabs()
        else
            self:Notify("Warning", "Cannot close the last tab!", 2, "warning")
        end
    end)
    
    tabBtn.MouseButton1Click:Connect(function()
        currentScript = tabBtn.Name:gsub("Tab_", "")
        for _, btn in pairs(uiRefs.EditorTabsContainer:GetChildren()) do
            if btn:IsA("TextButton") and btn.Name ~= "CloseTab" then
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            end
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        uiRefs.EditorBox.Text = scripts[currentScript] or ""
    end)
    
    table.insert(scriptTabs, tabBtn)
    
    if #scriptTabs == 1 then
        tabBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        currentScript = name
        uiRefs.EditorBox.Text = scripts[currentScript] or ""
    end
    
    -- Update canvas size
    uiRefs.EditorTabsContainer.CanvasSize = UDim2.new(#scriptTabs * 105, 0, 0, 0)
    tabCounter = tabCounter + 1
    
    -- Add script to list if not exists
    if not scripts[name] then
        scripts[name] = ""
        self:RefreshScriptList()
    end
end

function VortexX:UpdateEditorTabs()
    -- Rebuild tab positions
    for i, tab in ipairs(scriptTabs) do
        tab.Position = UDim2.new((i-1) * 105, 0, 0, 0)
    end
    uiRefs.EditorTabsContainer.CanvasSize = UDim2.new(#scriptTabs * 105, 0, 0, 0)
end

function VortexX:RefreshScriptList()
    local list = uiRefs.ScriptList
    -- Clear existing (keep scrollbar)
    for _, child in pairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local yPos = 0
    for name, _ in pairs(scripts) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.Position = UDim2.new(0, 5, 0, yPos)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        btn.Text = "📄 " .. name
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.TextSize = 13
        btn.Font = Enum.Font.SourceSans
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = list
        
        btn.MouseButton1Click:Connect(function()
            -- Open this script in editor
            currentScript = name
            uiRefs.EditorBox.Text = scripts[name] or ""
            -- Highlight tab
            for _, tab in ipairs(scriptTabs) do
                if tab.Name == "Tab_" .. name then
                    tab.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
                else
                    tab.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                end
            end
        end)
        
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        end)
        
        yPos = yPos + 35
    end
    
    list.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
end

function VortexX:AddScript(name, content)
    scripts[name] = content or ""
    self:RefreshScriptList()
    return self
end

function VortexX:DeleteScript(name)
    if scripts[name] then
        scripts[name] = nil
        self:RefreshScriptList()
        return true
    end
    return false
end

function VortexX:GetScript(name)
    return scripts[name]
end

--[[
    Action Functions
]]

function VortexX:ExecuteScript()
    local scriptText = uiRefs.EditorBox.Text
    if scriptText and scriptText ~= "" then
        local success, err = pcall(function()
            local func = loadstring(scriptText)
            if func then
                func()
            else
                error("Failed to load script")
            end
        end)
        if not success then
            self:Notify("Execution Error", err, 4, "error")
        else
            self:Notify("Success", "Script executed successfully!", 2, "success")
        end
    else
        self:Notify("Error", "No script to execute!", 2, "error")
    end
end

function VortexX:ClearEditor()
    uiRefs.EditorBox.Text = ""
    if currentScript then
        scripts[currentScript] = ""
    end
    self:Notify("Cleared", "Editor cleared!", 1, "info")
end

function VortexX:OpenScript()
    -- Open file dialog simulation
    self:Notify("Open", "Click a script from the folder to open it", 3, "info")
end

function VortexX:SaveScript()
    if currentScript then
        scripts[currentScript] = uiRefs.EditorBox.Text
        self:RefreshScriptList()
        self:Notify("Saved", "Script '" .. currentScript .. "' saved!", 2, "success")
    else
        self:Notify("Error", "No script selected to save!", 2, "error")
    end
end

function VortexX:InjectScript()
    local scriptText = uiRefs.EditorBox.Text
    if scriptText and scriptText ~= "" then
        -- Simulate injection with visual feedback
        self:Notify("Injected", "Script injected successfully!", 2, "success")
        -- In a real implementation, you would inject here
    else
        self:Notify("Error", "No script to inject!", 2, "error")
    end
end

function VortexX:KillPlayer()
    local player = game.Players.LocalPlayer
    if player and player.Character then
        local character = player.Character
        if character:FindFirstChild("Humanoid") then
            character.Humanoid.Health = 0
            self:Notify("Killed", "Player killed!", 2, "error")
        else
            self:Notify("Error", "No humanoid found!", 2, "error")
        end
    else
        self:Notify("Error", "Player not found!", 2, "error")
    end
end

function VortexX:UpdatePlayerCount()
    if uiRefs.PlayerLabel then
        local players = game:GetService("Players")
        local count = #players:GetPlayers()
        uiRefs.PlayerLabel.Text = "Player [" .. count .. "]"
    end
end

--[[
    Notification System
]]

function VortexX:Notify(title, message, duration, type)
    duration = duration or 3
    type = type or "info"
    
    if not uiRefs.MainContainer then return end
    
    local colors = {
        info = Color3.fromRGB(50, 150, 255),
        success = Color3.fromRGB(0, 200, 100),
        warning = Color3.fromRGB(255, 200, 50),
        error = Color3.fromRGB(255, 50, 50)
    }
    
    local notification = Instance.new("Frame")
    notification.Size = UDim2.new(0, 350, 0, 70)
    notification.Position = UDim2.new(1, -10, 0, 10 + #notificationQueue * 80)
    notification.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    notification.BorderSizePixel = 1
    notification.BorderColor3 = Color3.fromRGB(50, 50, 60)
    notification.Parent = uiRefs.MainContainer
    
    local colorBar = Instance.new("Frame")
    colorBar.Size = UDim2.new(0, 4, 1, 0)
    colorBar.BackgroundColor3 = colors[type] or colors.info
    colorBar.BorderSizePixel = 0
    colorBar.Parent = notification
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -15, 0.4, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = 15
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.Parent = notification
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -15, 0.5, 0)
    msgLabel.Position = UDim2.new(0, 10, 0.4, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = message
    msgLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    msgLabel.TextSize = 13
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.Parent = notification
    
    table.insert(notificationQueue, notification)
    
    -- Animate in
    local tweenService = game:GetService("TweenService")
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local posTween = tweenService:Create(notification, tweenInfo, {Position = UDim2.new(1, -370, 0, 10 + (#notificationQueue - 1) * 80)})
    posTween:Play()
    
    -- Auto remove
    task.wait(duration)
    
    -- Animate out
    local outTween = tweenService:Create(notification, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), 
        {Position = UDim2.new(1, -10, 0, 10 + (#notificationQueue - 1) * 80)})
    outTween:Play()
    task.wait(0.3)
    
    notification:Destroy()
    for i, n in ipairs(notificationQueue) do
        if n == notification then
            table.remove(notificationQueue, i)
            break
        end
    end
    
    -- Update positions of remaining notifications
    for i, n in ipairs(notificationQueue) do
        n:TweenPosition(UDim2.new(1, -370, 0, 10 + (i - 1) * 80), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
    end
end

--[[
    Destroy
]]

function VortexX:DestroyAll()
    if uiRefs.MainGui then
        uiRefs.MainGui:Destroy()
        uiRefs = {}
        isOpen = false
        isAnimating = false
        notificationQueue = {}
    end
end

