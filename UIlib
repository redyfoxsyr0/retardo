local VortexUI = {}

-- Internal
local uiRefs = {}
local isOpen = false

function VortexUI:CreateUI()
    if uiRefs.MainGui then
        uiRefs.MainGui:Destroy()
        uiRefs = {}
    end
    
    if not game or not game:GetService("CoreGui") then
        error("Requires Roblox CoreGui")
        return
    end
    
    local coreGui = game:GetService("CoreGui")
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "VortexX_MainUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = coreGui
    
    -- Main container
    local mainContainer = Instance.new("Frame")
    mainContainer.Name = "MainContainer"
    mainContainer.Size = UDim2.new(1, 0, 1, 0)
    mainContainer.BackgroundTransparency = 1
    mainContainer.Visible = false
    mainContainer.Parent = screenGui
    
    -- Overlay
    local overlay = Instance.new("Frame")
    overlay.Name = "Overlay"
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    overlay.BackgroundTransparency = 0.5
    overlay.Visible = false
    overlay.Parent = mainContainer
    
    local overlayButton = Instance.new("TextButton")
    overlayButton.Name = "OverlayButton"
    overlayButton.Size = UDim2.new(1, 0, 1, 0)
    overlayButton.BackgroundTransparency = 1
    overlayButton.Text = ""
    overlayButton.Parent = overlay
    
    -- Main window
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 550, 0, 600)
    mainFrame.Position = UDim2.new(0.5, -275, 0.5, -300)
    mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    mainFrame.BorderSizePixel = 1
    mainFrame.BorderColor3 = Color3.fromRGB(40, 40, 50)
    mainFrame.Parent = mainContainer
    
    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = mainFrame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(0.7, 0, 1, 0)
    titleLabel.Position = UDim2.new(0, 15, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "⚡ Vortex X"
    titleLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    titleLabel.TextSize = 20
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.Parent = titleBar
    
    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.new(0, 40, 1, 0)
    closeButton.Position = UDim2.new(1, -40, 0, 0)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = "✕"
    closeButton.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeButton.TextSize = 20
    closeButton.Font = Enum.Font.SourceSansBold
    closeButton.Parent = titleBar
    
    -- Top bar button
    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"
    topBar.Size = UDim2.new(0, 120, 0, 35)
    topBar.Position = UDim2.new(0, 10, 0, 10)
    topBar.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    topBar.BorderSizePixel = 1
    topBar.BorderColor3 = Color3.fromRGB(40, 40, 50)
    topBar.Parent = mainContainer
    
    local topButton = Instance.new("TextButton")
    topButton.Name = "TopButton"
    topButton.Size = UDim2.new(1, 0, 1, 0)
    topButton.BackgroundTransparency = 1
    topButton.Text = "⚡ Vortex X"
    topButton.TextColor3 = Color3.fromRGB(255, 200, 50)
    topButton.TextSize = 13
    topButton.Font = Enum.Font.SourceSansBold
    topButton.Parent = topBar
    
    -- Content area
    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "ContentFrame"
    contentFrame.Size = UDim2.new(1, -20, 1, -55)
    contentFrame.Position = UDim2.new(0, 10, 0, 45)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = mainFrame
    
    -- Tabs
    local tabsFrame = Instance.new("Frame")
    tabsFrame.Name = "TabsFrame"
    tabsFrame.Size = UDim2.new(1, 0, 0, 30)
    tabsFrame.BackgroundTransparency = 1
    tabsFrame.Parent = contentFrame
    
    local tabsLabel = Instance.new("TextLabel")
    tabsLabel.Name = "TabsLabel"
    tabsLabel.Size = UDim2.new(0.15, 0, 1, 0)
    tabsLabel.BackgroundTransparency = 1
    tabsLabel.Text = "TABS"
    tabsLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    tabsLabel.TextSize = 12
    tabsLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabsLabel.Font = Enum.Font.SourceSansBold
    tabsLabel.Parent = tabsFrame
    
    local tabsContainer = Instance.new("ScrollingFrame")
    tabsContainer.Name = "TabsContainer"
    tabsContainer.Size = UDim2.new(0.85, -10, 1, 0)
    tabsContainer.Position = UDim2.new(0.15, 10, 0, 0)
    tabsContainer.BackgroundTransparency = 1
    tabsContainer.ScrollBarThickness = 3
    tabsContainer.VerticalScrollBarPosition = Enum.VerticalScrollBarPosition.Right
    tabsContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabsContainer.Parent = tabsFrame
    
    local addTabBtn = Instance.new("TextButton")
    addTabBtn.Name = "AddTabBtn"
    addTabBtn.Size = UDim2.new(0, 100, 1, 0)
    addTabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    addTabBtn.Text = "+ Add new tab"
    addTabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    addTabBtn.TextSize = 12
    addTabBtn.Font = Enum.Font.SourceSans
    addTabBtn.Parent = tabsContainer
    
    -- Separator
    local separator1 = Instance.new("Frame")
    separator1.Name = "Separator1"
    separator1.Size = UDim2.new(1, 0, 0, 1)
    separator1.Position = UDim2.new(0, 0, 0, 35)
    separator1.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    separator1.BorderSizePixel = 0
    separator1.Parent = contentFrame
    
    -- Scripts folder
    local scriptsFrame = Instance.new("Frame")
    scriptsFrame.Name = "ScriptsFrame"
    scriptsFrame.Size = UDim2.new(1, 0, 0, 200)
    scriptsFrame.Position = UDim2.new(0, 0, 0, 40)
    scriptsFrame.BackgroundTransparency = 1
    scriptsFrame.Parent = contentFrame
    
    local folderLabel = Instance.new("TextLabel")
    folderLabel.Name = "FolderLabel"
    folderLabel.Size = UDim2.new(1, 0, 0, 25)
    folderLabel.BackgroundTransparency = 1
    folderLabel.Text = "📁 SCRIPTS FOLDER"
    folderLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    folderLabel.TextSize = 12
    folderLabel.TextXAlignment = Enum.TextXAlignment.Left
    folderLabel.Font = Enum.Font.SourceSansBold
    folderLabel.Parent = scriptsFrame
    
    local scriptList = Instance.new("ScrollingFrame")
    scriptList.Name = "ScriptList"
    scriptList.Size = UDim2.new(1, 0, 1, -30)
    scriptList.Position = UDim2.new(0, 0, 0, 25)
    scriptList.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    scriptList.BorderSizePixel = 1
    scriptList.BorderColor3 = Color3.fromRGB(35, 35, 42)
    scriptList.ScrollBarThickness = 4
    scriptList.CanvasSize = UDim2.new(0, 0, 0, 0)
    scriptList.Parent = scriptsFrame
    
    -- Separator
    local separator2 = Instance.new("Frame")
    separator2.Name = "Separator2"
    separator2.Size = UDim2.new(1, 0, 0, 1)
    separator2.Position = UDim2.new(0, 0, 0, 245)
    separator2.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    separator2.BorderSizePixel = 0
    separator2.Parent = contentFrame
    
    -- Editor
    local editorFrame = Instance.new("Frame")
    editorFrame.Name = "EditorFrame"
    editorFrame.Size = UDim2.new(1, 0, 1, -250)
    editorFrame.Position = UDim2.new(0, 0, 0, 250)
    editorFrame.BackgroundTransparency = 1
    editorFrame.Parent = contentFrame
    
    local editorLabel = Instance.new("TextLabel")
    editorLabel.Name = "EditorLabel"
    editorLabel.Size = UDim2.new(1, 0, 0, 20)
    editorLabel.BackgroundTransparency = 1
    editorLabel.Text = "📝 Editor"
    editorLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    editorLabel.TextSize = 12
    editorLabel.TextXAlignment = Enum.TextXAlignment.Left
    editorLabel.Font = Enum.Font.SourceSansBold
    editorLabel.Parent = editorFrame
    
    local editorBox = Instance.new("TextBox")
    editorBox.Name = "EditorBox"
    editorBox.Size = UDim2.new(1, 0, 1, -25)
    editorBox.Position = UDim2.new(0, 0, 0, 20)
    editorBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    editorBox.BorderSizePixel = 1
    editorBox.BorderColor3 = Color3.fromRGB(35, 35, 42)
    editorBox.Text = ""
    editorBox.TextColor3 = Color3.fromRGB(200, 220, 255)
    editorBox.TextSize = 13
    editorBox.Font = Enum.Font.Code
    editorBox.TextXAlignment = Enum.TextXAlignment.Left
    editorBox.TextYAlignment = Enum.TextYAlignment.Top
    editorBox.MultiLine = true
    editorBox.ClearTextOnFocus = false
    editorBox.PlaceholderText = "Type your script here..."
    editorBox.PlaceholderColor3 = Color3.fromRGB(80, 80, 100)
    editorBox.Parent = editorFrame
    
    -- Buttons
    local buttonBar = Instance.new("Frame")
    buttonBar.Name = "ButtonBar"
    buttonBar.Size = UDim2.new(1, 0, 0, 40)
    buttonBar.Position = UDim2.new(0, 0, 1, -40)
    buttonBar.BackgroundTransparency = 1
    buttonBar.Parent = contentFrame
    
    local buttons = {}
    local buttonNames = {"Execute", "Clear", "Open", "Save", "Inject"}
    local buttonColors = {
        Color3.fromRGB(0, 200, 100),
        Color3.fromRGB(200, 50, 50),
        Color3.fromRGB(50, 150, 255),
        Color3.fromRGB(255, 150, 50),
        Color3.fromRGB(200, 50, 200)
    }
    
    for i, name in ipairs(buttonNames) do
        local btn = Instance.new("TextButton")
        btn.Name = "Btn_" .. name
        btn.Size = UDim2.new(0, 80, 1, -5)
        btn.Position = UDim2.new((i-1) * 0.12 + 0.01, 0, 0, 2.5)
        btn.BackgroundColor3 = buttonColors[i]
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.SourceSansBold
        btn.BackgroundTransparency = 0.2
        btn.Parent = buttonBar
        
        btn.MouseEnter:Connect(function()
            btn.BackgroundTransparency = 0
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundTransparency = 0.2
        end)
        
        buttons[name] = btn
    end
    
    -- Player info
    local playerFrame = Instance.new("Frame")
    playerFrame.Name = "PlayerFrame"
    playerFrame.Size = UDim2.new(0, 180, 1, -5)
    playerFrame.Position = UDim2.new(1, -185, 0, 2.5)
    playerFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    playerFrame.BorderSizePixel = 0
    playerFrame.Parent = buttonBar
    
    local playerLabel = Instance.new("TextLabel")
    playerLabel.Name = "PlayerLabel"
    playerLabel.Size = UDim2.new(0.55, -10, 1, 0)
    playerLabel.Position = UDim2.new(0, 5, 0, 0)
    playerLabel.BackgroundTransparency = 1
    playerLabel.Text = "No Roblox"
    playerLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    playerLabel.TextSize = 12
    playerLabel.TextXAlignment = Enum.TextXAlignment.Left
    playerLabel.Font = Enum.Font.SourceSans
    playerLabel.Parent = playerFrame
    
    local killBtn = Instance.new("TextButton")
    killBtn.Name = "KillBtn"
    killBtn.Size = UDim2.new(0.4, -10, 0.8, 0)
    killBtn.Position = UDim2.new(0.6, 5, 0.5, -15)
    killBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    killBtn.Text = "Kill"
    killBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    killBtn.TextSize = 12
    killBtn.Font = Enum.Font.SourceSansBold
    killBtn.BackgroundTransparency = 0.2
    killBtn.Parent = playerFrame
    
    killBtn.MouseEnter:Connect(function()
        killBtn.BackgroundTransparency = 0
    end)
    killBtn.MouseLeave:Connect(function()
        killBtn.BackgroundTransparency = 0.2
    end)
    
    -- Draggable
    local dragging = false
    local dragStart, startPos
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Store references
    uiRefs = {
        MainGui = screenGui,
        MainContainer = mainContainer,
        Overlay = overlay,
        MainFrame = mainFrame,
        TopBar = topBar,
        TopButton = topButton,
        CloseButton = closeButton,
        TabsContainer = tabsContainer,
        AddTabBtn = addTabBtn,
        ScriptList = scriptList,
        EditorBox = editorBox,
        Buttons = buttons,
        PlayerLabel = playerLabel,
        KillBtn = killBtn,
        OverlayButton = overlayButton,
        TitleBar = titleBar
    }
    
    return uiRefs
end

-- UI Control Functions
function VortexUI:OpenUI()
    if not uiRefs.MainContainer then return end
    uiRefs.MainContainer.Visible = true
    uiRefs.Overlay.Visible = true
    isOpen = true
end

function VortexUI:CloseUI()
    if not uiRefs.MainContainer or not isOpen then return end
    uiRefs.MainContainer.Visible = false
    uiRefs.Overlay.Visible = false
    isOpen = false
end

function VortexUI:ToggleUI()
    if isOpen then
        self:CloseUI()
    else
        self:OpenUI()
    end
end

function VortexUI:IsOpen()
    return isOpen
end

function VortexUI:GetUI()
    return uiRefs
end

function VortexUI:DestroyAll()
    if uiRefs.MainGui then
        uiRefs.MainGui:Destroy()
        uiRefs = {}
        isOpen = false
    end
end

return VortexUI
